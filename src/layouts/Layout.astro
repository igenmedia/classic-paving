---
import "../styles/global.css";
import { business, services, areas } from "../data/business";
import { hero } from "../data/gallery";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  heroImage?: string;
  schema?: Record<string, unknown>[];
}

const { title, description, noindex = false, heroImage, schema = [] } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "");
const canonical = new URL(path || "/", business.url).toString();
const ogImage = new URL(hero?.src ?? "/apple-touch-icon.png", business.url).toString();
const { landline, freephone, mobile } = business.phones;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": business.url + "/#business",
  name: business.name,
  url: business.url,
  description: `Driveways, patios and block paving across ${business.base} and roughly ${business.radius} around it.`,
  telephone: landline.tel,
  email: business.email,
  logo: { "@type": "ImageObject", url: business.url + "/favicon.svg" },
  ...(hero ? { image: business.url + hero.src } : {}),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Oxford",
    addressRegion: "Oxfordshire",
    addressCountry: "GB",
  },
  geo: { "@type": "GeoCoordinates", latitude: business.geo.latitude, longitude: business.geo.longitude },
  areaServed: areas.map((name) => ({ "@type": "Place", name })),
  ...(business.sameAs.length ? { sameAs: business.sameAs } : {}),
};
const allSchema = [localBusiness, ...schema];

const nav = [
  { href: "/", label: "Home" },
  { href: "/#services", label: "Services" },
  { href: "/#our-work", label: "Our Work" },
  { href: "/#areas", label: "Areas" },
  { href: "/contact", label: "Contact" },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-serif-display-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/figtree-var.woff2" crossorigin />
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="antialiased">
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-stone-200">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2.5" aria-label={`${business.name} home`}>
          <img src="/favicon.svg" alt="" width="36" height="36" />
          <span class="font-serif text-2xl text-moss leading-none">{business.name}</span>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-sm font-semibold" aria-label="Main">
          {nav.map((n) => <a href={n.href} class="text-stone-700 hover:text-moss">{n.label}</a>)}
        </nav>

        <div class="flex items-center gap-2">
          <a href={`tel:${landline.tel}`} class="hidden sm:inline-flex items-center gap-2 rounded-md bg-moss px-4 py-2 text-sm font-semibold text-white hover:bg-moss-dark">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
            {landline.display}
          </a>
          <a href={`tel:${landline.tel}`} class="sm:hidden inline-flex h-10 w-10 items-center justify-center rounded-md bg-moss text-white" aria-label={`Call ${business.name}`}>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
          </a>
          <button id="menu-btn" type="button" class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-md border border-stone-300" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">
            <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg id="icon-close" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="md:hidden hidden border-t border-stone-200 bg-white" aria-label="Mobile">
        <div class="px-4 py-3 flex flex-col">
          {nav.map((n) => <a href={n.href} class="py-2.5 font-semibold text-stone-800">{n.label}</a>)}
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-ink text-stone-300">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 grid gap-10 md:grid-cols-3">
        <div>
          <p class="font-serif text-2xl text-white">{business.name}</p>
          <p class="mt-3 text-sm leading-relaxed">
            Driveways, patios and paving from an Oxford-based team, working up to {business.radius} out in every direction.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-white">Get in touch</h3>
          <ul class="mt-4 space-y-2 text-sm">
            <li>Oxford: <a class="text-brass hover:text-white" href={`tel:${landline.tel}`}>{landline.display}</a></li>
            <li>Freephone: <a class="text-brass hover:text-white" href={`tel:${freephone.tel}`}>{freephone.display}</a></li>
            <li>Mobile: <a class="text-brass hover:text-white" href={`tel:${mobile.tel}`}>{mobile.display}</a></li>
            <li>Email: <a class="text-brass hover:text-white break-all" href={`mailto:${business.email}`}>{business.email}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-white">Services</h3>
          <ul class="mt-4 space-y-2 text-sm">
            {services.map((s) => <li><a class="hover:text-white" href={`/#${s.slug}`}>{s.name}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-stone-400">
          <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
          <a href="/privacy-policy" class="hover:text-white">Privacy Policy</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById("menu-btn");
      const panel = document.getElementById("mobile-nav");
      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        panel?.classList.toggle("hidden", open);
        document.getElementById("icon-open")?.classList.toggle("hidden", !open);
        document.getElementById("icon-close")?.classList.toggle("hidden", open);
      });
      panel?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => btn?.click()));
    </script>
  </body>
</html>
