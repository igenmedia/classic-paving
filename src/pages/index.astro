---
import Layout from "../layouts/Layout.astro";
import CallBlock from "../components/CallBlock.astro";
import { business, services, areas } from "../data/business";
import { hero, gallery, beforeAfter } from "../data/gallery";

const { landline, freephone } = business.phones;

const steps = [
  { title: "Phone call", text: "Tell John roughly what you're after. If it sounds like something we can help with, we'll arrange a time to come round." },
  { title: "Site visit & price", text: "We look at the ground, the levels and where the water goes, measure up and give you a written price. Free, and no pushing." },
  { title: "The groundwork", text: "Old surface out, dig to the right depth, sub-base in and compacted in layers. This is the bit that decides how long a drive lasts." },
  { title: "Laying & finishing", text: "Edging, paving, cuts and jointing, then a clean down. We walk round it with you before we pack up." },
];

const faqs = [
  {
    q: "How far do you travel from Oxford?",
    a: `We're based in Oxford and regularly work 30 to 40 miles out, so most of Oxfordshire plus parts of Bucks, Berkshire, Northants and Wiltshire. If you're not sure you're in range, just ring and ask.`,
  },
  {
    q: "Do I need planning permission for a new front driveway?",
    a: "Usually not, as long as the surface is permeable (or the rain drains onto a lawn or border on your own property). Covering more than 5 square metres of front garden with a hard surface that drains onto the road does need permission. A dropped kerb needs approval from Oxfordshire County Council or your local highways authority. We'll talk you through what applies to your house on the visit.",
  },
  {
    q: "How long does a typical driveway take?",
    a: "Most block paved drives take somewhere between a few days and a week and a half, depending on size, how much has to come out and the weather. You'll get a realistic timescale with your quote.",
  },
  {
    q: "Is the quote really free?",
    a: "Yes. We come out, measure up and give you a written price. There's no charge for that and no obligation to go ahead.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const websiteSchema = { "@context": "https://schema.org", "@type": "WebSite", name: business.name, url: business.url };
---

<Layout
  title="Driveways & Patios Oxford – Classic Paving"
  description="Block paving, driveways and patios in Oxford and up to 40 miles around. Free site visits and written quotes. Call Classic Paving on 01865 389180."
  heroImage={hero?.src}
  schema={[websiteSchema, faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden text-white">
    {hero ? (
      <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" loading="eager" />
    ) : (
      <div class="absolute inset-0 pave-bg" />
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/70 to-ink/30"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 py-20 sm:py-28">
      <p class="text-brass font-semibold tracking-wide uppercase text-sm">Oxford &amp; 30-40 miles around</p>
      <h1 class="mt-3 text-5xl sm:text-6xl leading-[1.05] max-w-2xl">Driveways &amp; Patios Oxford</h1>
      <h2 class="mt-4 text-2xl sm:text-3xl text-sand">Classic Paving</h2>
      <h3 class="mt-4 max-w-xl text-lg text-stone-200 font-normal leading-relaxed">
        Block paving, patios, driveways and the groundwork underneath, laid properly for homes across Oxford and the surrounding towns and villages.
      </h3>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`tel:${landline.tel}`} class="rounded-md bg-brass px-6 py-3.5 font-bold text-ink hover:bg-sand">Call {landline.display}</a>
        <a href={`tel:${freephone.tel}`} class="rounded-md border border-white/40 px-6 py-3.5 font-semibold hover:bg-white/10">Freephone {freephone.display}</a>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="bg-sand-light border-b border-sand">
    <ul class="mx-auto max-w-6xl px-4 sm:px-6 py-6 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm font-semibold text-moss-dark">
      <li class="flex items-center gap-2"><span class="text-brass-dark" aria-hidden="true">&#10003;</span> Free site visits</li>
      <li class="flex items-center gap-2"><span class="text-brass-dark" aria-hidden="true">&#10003;</span> Written quotes</li>
      <li class="flex items-center gap-2"><span class="text-brass-dark" aria-hidden="true">&#10003;</span> Based in Oxford</li>
      <li class="flex items-center gap-2"><span class="text-brass-dark" aria-hidden="true">&#10003;</span> Ask for John</li>
    </ul>
  </section>

  <!-- Intro -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-16 text-center">
    <h2 class="text-4xl text-moss">Paving and driveways in Oxford, done the old-fashioned way</h2>
    <p class="mt-5 text-lg text-stone-700 leading-relaxed">
      Classic Paving lays driveways and patios in Oxford and across a good 30 to 40 miles of the county around it. The name says what we're about: solid groundwork, neat lines and a finish that still looks right years later. Ring up and you'll speak to John, who prices the work, turns up on the day and makes sure it's done properly.
    </p>
  </section>

  <!-- Services -->
  <section id="services" class="bg-stone-50 py-16 scroll-mt-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-4xl text-moss text-center">What we do around Oxford</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <article id={s.slug} class="rounded-lg bg-white p-6 shadow-sm border border-stone-200 scroll-mt-20">
            <h3 class="text-xl font-bold text-ink">{s.name}</h3>
            <p class="mt-3 text-stone-700 leading-relaxed">{s.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  {gallery.length > 0 && (
    <section id="our-work" class="py-16 scroll-mt-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-4xl text-moss text-center">Some of our recent work</h2>
        <p class="mt-4 text-center text-stone-600 max-w-2xl mx-auto">Every photo here is one of our own jobs.</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {gallery.map((p) => (
            <figure class="overflow-hidden rounded-lg bg-stone-100">
              <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" class="aspect-[4/3] w-full object-cover" />
              {p.caption && <figcaption class="px-4 py-3 text-sm text-stone-700">{p.caption}</figcaption>}
            </figure>
          ))}
        </div>

        <div class="mt-16 grid gap-8 md:grid-cols-2 items-center">
          <div>
            <h3 class="font-serif text-3xl text-moss">Before &amp; after: a tired gravel drive</h3>
            <p class="mt-4 text-stone-700 leading-relaxed">
              Before, the gravel was thin and weedy with a broken edge onto the pavement. After, it's a fresh gravel drive held in by a red block paved strip across the front, so the stones stay where they belong.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[["Before", beforeAfter.before], ["After", beforeAfter.after]].map(([label, p]: any) => (
              <figure class="overflow-hidden rounded-lg bg-stone-100">
                <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" class="w-full h-auto" />
                <figcaption class="px-3 py-2 text-sm font-bold text-moss-dark">{label}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Process -->
  <section class="bg-moss text-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-4xl text-center">How a job runs</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-lg bg-white/5 p-6 border border-white/10">
            <span class="font-serif text-4xl text-brass">{i + 1}</span>
            <h3 class="mt-2 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-stone-200 text-sm leading-relaxed">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Why us -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-16 grid gap-10 md:grid-cols-2 items-center">
    <div>
      <h2 class="text-4xl text-moss">Why people in Oxfordshire call us</h2>
      <ul class="mt-6 space-y-4 text-stone-700">
        <li class="flex gap-3"><span class="text-brass-dark font-bold" aria-hidden="true">&#10003;</span><span><strong class="text-ink">You deal with John throughout.</strong> The person who quotes is the person who's on site.</span></li>
        <li class="flex gap-3"><span class="text-brass-dark font-bold" aria-hidden="true">&#10003;</span><span><strong class="text-ink">No skimping underneath.</strong> A lot of the ground round Oxford is clay, which holds water and moves. A thin sub-base is why so many drives sink, so we don't do thin.</span></li>
        <li class="flex gap-3"><span class="text-brass-dark font-bold" aria-hidden="true">&#10003;</span><span><strong class="text-ink">A clear, written price.</strong> You'll know what's included before anything starts.</span></li>
        <li class="flex gap-3"><span class="text-brass-dark font-bold" aria-hidden="true">&#10003;</span><span><strong class="text-ink">Tidy sites.</strong> Skips, deliveries and spoil are sorted, and we leave the place swept.</span></li>
      </ul>
    </div>
    <CallBlock heading="Want a price?" />
  </section>

  <!-- FAQ -->
  <section class="bg-stone-50 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-4xl text-moss text-center">Common questions</h2>
      <div class="mt-10 space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-lg bg-white border border-stone-200 p-5">
            <summary class="cursor-pointer list-none flex justify-between gap-4 font-bold text-ink">
              <h3 class="text-base">{f.q}</h3>
              <span class="text-brass-dark group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-stone-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Areas -->
  <section id="areas" class="py-16 scroll-mt-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 text-center">
      <h2 class="text-4xl text-moss">Areas we cover from Oxford</h2>
      <p class="mt-4 max-w-2xl mx-auto text-stone-700">
        We work roughly 30 to 40 miles from Oxford. These are the places we get called out to most, but if your village isn't listed, ring anyway.
      </p>
      <ul class="mt-8 flex flex-wrap justify-center gap-2">
        {areas.map((a) => <li class="rounded-full bg-sand-light border border-sand px-4 py-1.5 text-sm text-moss-dark">{a}</li>)}
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-ink text-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <h2 class="text-4xl">Get a free quote for your drive or patio</h2>
      <p class="mt-4 text-stone-300">Give John a ring. He'll come out, take a look and give you a straight price.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`tel:${landline.tel}`} class="rounded-md bg-brass px-6 py-3.5 font-bold text-ink hover:bg-sand">Call {landline.display}</a>
        <a href="/contact" class="rounded-md border border-white/40 px-6 py-3.5 font-semibold hover:bg-white/10">All contact numbers</a>
      </div>
    </div>
  </section>
</Layout>
